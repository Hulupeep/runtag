   "components/scenes/Scene8CTA.tsx",
   "app/(shell)/",
   "lib/app/store.ts",
   "lib/app/chain.ts",
   "lib/app/route.ts",
   "lib/app/nav.ts",
   "lib/app/origin.ts",
   "scripts/sw/",
   "public/manifest.webmanifest",
   "public/icons/",
   "next.config.mjs",
   "package.json",
   ".gitignore",
   "docs/contracts/feature_app.yml",
   "docs/contracts/feature_app_defaults.yml",
   "docs/contracts/journey_app_offline.yml",
   "tests/e2e/journey_app_offline.spec.ts",
   "lib/constants.ts"
  ]
 },
 {
  "id": "APP-TAP",
  "writes": [
   "/t/",
