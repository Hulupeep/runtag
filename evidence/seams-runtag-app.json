   "TAG_ORIGIN",
   "newTagId",
   "withTxn",
   "nav-tags"
  ]
 },
 {
  "id": "APP-DURABLE",
  "writes": [
   "/app/settings"
  ],
  "reads": [
   "withTxn",
   "StoreError",
   "computeChain",
   "nav-settings"
  ]
 },
 {
  "id": "APP-LINK",
  "writes": [
   "start-for-real"
  ],
  "reads": [
   "/app",
   "Email address"
  ]
 }
]